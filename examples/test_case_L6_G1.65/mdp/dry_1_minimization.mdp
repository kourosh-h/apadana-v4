define                  = -DPOSRES_SURFACE
;---------------------------------------------------
integrator               = steep
;---------------------------------------------------
nstxtcout                = 1000
;---------------------------------------------------
emtol                    = 10
emstep                   = 0.001
;---------------------------------------------------
;nstcgsteep              = 100
nsteps                   = 1000000
;---------------------------------------------------
nstlist                  = 12
cutoff-scheme            = Verlet
rlist                    = 1.2
;---------------------------------------------------
vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw_switch              = 1.0
rvdw                     = 1.2
coulombtype              = pme
rcoulomb                 = 1.2
;---------------------------------------------------
pbc                      = xyz
periodic-molecules       = yes
;---------------------------------------------------
; Generate velocities
gen_vel          = yes
gen_temp         = 300
gen_seed         = 1
